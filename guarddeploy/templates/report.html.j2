<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ project_name }} — Security & ISO 27001 Evidence Report</title>
<style>
  :root {
    --navy: #1F3864;
    --navy-dark: #142544;
    --accent: #2E75B6;
    --bg: #F4F6F9;
    --card: #FFFFFF;
    --critical: #B00020;
    --high: #D9822B;
    --medium: #D4A017;
    --low: #4C8C4A;
    --info: #6C7A89;
    --text: #1A1F29;
    --muted: #5B6472;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 0 0 60px 0;
  }
  header {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%);
    color: #fff;
    padding: 36px 48px;
  }
  header h1 { margin: 0 0 6px 0; font-size: 26px; }
  header p { margin: 0; color: #C9D6E8; font-size: 14px; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin: -28px 0 32px 0;
  }
  .stat-card {
    background: var(--card);
    border-radius: 10px;
    padding: 18px;
    box-shadow: 0 2px 10px rgba(20,37,68,0.12);
    text-align: center;
  }
  .stat-card .value { font-size: 28px; font-weight: 700; color: var(--navy); }
  .stat-card .label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; margin-top: 4px; }
  .stat-card.critical .value { color: var(--critical); }
  section { margin-bottom: 36px; }
  h2 {
    color: var(--navy);
    font-size: 18px;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 8px;
    margin-bottom: 16px;
  }
  .card { background: var(--card); border-radius: 10px; padding: 24px; box-shadow: 0 2px 10px rgba(20,37,68,0.08); }
  ul.recommendations { padding-left: 20px; margin: 0; }
  ul.recommendations li { margin-bottom: 10px; line-height: 1.5; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th {
    text-align: left;
    background: var(--navy);
    color: #fff;
    padding: 10px 12px;
    position: sticky;
    top: 0;
  }
  td { padding: 10px 12px; border-bottom: 1px solid #E4E9F0; vertical-align: top; }
  tr:hover td { background: #F0F4FA; }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    letter-spacing: .03em;
  }
  .badge.CRITICAL { background: var(--critical); }
  .badge.HIGH { background: var(--high); }
  .badge.MEDIUM { background: var(--medium); color: #3a2c00; }
  .badge.LOW { background: var(--low); }
  .badge.INFO, .badge.UNKNOWN { background: var(--info); }
  .iso-chip {
    display: inline-block;
    background: #E8F0FB;
    color: var(--navy);
    border: 1px solid #C9D6E8;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    margin: 2px 3px 2px 0;
    font-weight: 600;
  }
  .source-tag { font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .tool-errors { background: #FFF6E8; border: 1px solid #F0D9A8; border-radius: 8px; padding: 14px 18px; font-size: 13px; color: #6B4F14; }
  footer { text-align: center; color: var(--muted); font-size: 12px; margin-top: 40px; }
  .rationale { color: var(--muted); font-size: 12px; margin-top: 4px; }
</style>
</head>
<body>

<header>
  <h1>{{ project_name }} — Security &amp; ISO 27001 Evidence Report</h1>
  <p>Generated {{ generated_at }} UTC · GuardDeploy automated evidence pipeline</p>
</header>

<div class="container">

  <div class="summary-grid">
    <div class="stat-card"><div class="value">{{ summary.total_checks }}</div><div class="label">Total Checks</div></div>
    <div class="stat-card"><div class="value">{{ summary.pass_rate_pct }}%</div><div class="label">Pass Rate</div></div>
    <div class="stat-card critical"><div class="value">{{ summary.critical_count }}</div><div class="label">Critical Findings</div></div>
    <div class="stat-card"><div class="value">{{ summary.total_failed }}</div><div class="label">Total Failed</div></div>
    <div class="stat-card"><div class="value">{{ findings|length }}</div><div class="label">Findings Evaluated</div></div>
  </div>

  {% if tool_errors %}
  <section>
    <div class="tool-errors">
      <strong>Notes:</strong>
      <ul style="margin:6px 0 0 18px;">
        {% for err in tool_errors %}<li>{{ err }}</li>{% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <section>
    <h2>Executive Summary</h2>
    <div class="card">
      <p style="margin-top:0;">
        This report covers {{ summary.total_checks }} automated security checks across
        infrastructure-as-code and container scanning, with a
        {{ summary.pass_rate_pct }}% pass rate and {{ summary.critical_count }} critical
        finding(s) requiring immediate remediation. Every failed check below is mapped
        to its relevant ISO/IEC 27001:2022 Annex A control for audit evidence purposes.
      </p>
      {% if summary.top_recommendations %}
      <strong>Top recommendations:</strong>
      <ul class="recommendations">
        {% for rec in summary.top_recommendations %}<li>{{ rec }}</li>{% endfor %}
      </ul>
      {% else %}
      <p><em>No failed checks to report — all evaluated controls passed.</em></p>
      {% endif %}
    </div>
  </section>

  <section>
    <h2>Findings by Severity</h2>
    <div class="card">
      <table>
        <thead>
          <tr>
            <th>Severity</th>
            <th>Source</th>
            <th>Check / CVE</th>
            <th>Title</th>
            <th>Resource</th>
            <th>ISO 27001 Annex A</th>
          </tr>
        </thead>
        <tbody>
          {% for sev in severity_order %}
            {% for f in findings if f.severity == sev and not f.passed %}
            <tr>
              <td><span class="badge {{ f.severity }}">{{ f.severity }}</span></td>
              <td><span class="source-tag">{{ f.source }}</span></td>
              <td>{{ f.check_id }}</td>
              <td>
                {{ f.title }}
                <div class="rationale">{{ f.control_mapping.rationale }}</div>
              </td>
              <td>{{ f.resource }}</td>
              <td>
                {% for c in f.control_mapping.iso_controls %}
                  <span class="iso-chip" title="{{ c.title }}">{{ c.ref }}</span>
                {% endfor %}
                {% if f.control_mapping.cis_aws_ref %}
                  <div class="rationale">{{ f.control_mapping.cis_aws_ref }}</div>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <footer>
    GuardDeploy · automated Cloud DevSecOps compliance evidence · not a substitute for a full ISO 27001 audit
  </footer>

</div>
</body>
</html>
